class Solution:
    def minSubArrayLen(self, target: int, nums: List[int]) -> int:
        
        minlen=float('inf');
        sum=0
        l=0
        for i in range(len(nums)):
            sum+=nums[i]
            while(sum>=target):
                minlen=min(minlen,i-l+1)
                sum-=nums[l]
                l+=1

            

        
        if (minlen == float('inf')) :
            return 0
        

        return minlen 
